# Appwrite Configuration
# =====================
# Get these values from your Appwrite Console: https://cloud.appwrite.io/console

# Your Appwrite Project ID (find it in Settings > General)
VITE_APPWRITE_PROJECT_ID=your-project-id-here

# Your Appwrite Project Name (optional, for display purposes)
VITE_APPWRITE_PROJECT_NAME=PDF Storage App

# Appwrite API Endpoint
# For Appwrite Cloud, use: https://cloud.appwrite.io/v1
# For self-hosted, use your server URL with /v1 suffix
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Storage Bucket ID (create this bucket in Appwrite Console > Storage)
VITE_APPWRITE_BUCKET_ID=user-pdfs

# =====================
# Setup Instructions:
# =====================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values above with your Appwrite project details
# 3. Follow SETUP_GUIDE.md for complete Appwrite configuration
